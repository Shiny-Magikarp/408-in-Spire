<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Spire408</AssemblyName>
    <Version>0.8.1</Version>
    <RootNamespace>Spire408</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GameData>$(MSBuildThisFileDirectory)..\..\data_sts2_windows_x86_64</GameData>
    <RitsuLibReferenceTarget>0.111.0</RitsuLibReferenceTarget>
    <DefineConstants Condition="'$(EnableSmoke)' == 'true'">$(DefineConstants);SMOKE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="src/**/*.cs;addons/mega_text/**/*.cs" />
    <Reference Include="sts2" HintPath="$(GameData)\sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameData)\0Harmony.dll" Private="false" />
  </ItemGroup>
  <Import Project="../.tools/ritsulib/RitsuLib.References.props" />
  <ItemGroup Condition="'$(PreviewBuild)' == 'true'">
    <Reference Update="@(Reference)" Private="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSmoke)' == 'true'">
    <Compile Include="../tests/GameSmoke.cs" Link="GameSmoke.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
  </ItemGroup>
</Project>
